{
  "name": "linkmodel-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "LinkModel 电脑端：本地 AI 统一接口（AI 网关），模型列表 + 统一 /v1/chat",
  "type": "module",
  "main": "dist/electron-main.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts start",
    "connect": "tsx src/connect.ts",
    "pair": "tsx src/index.ts pair",
    "icons": "node scripts/make-icons.mjs",
    "electron": "tsc && electron .",
    "dist": "tsc && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "verify:win-package": "node scripts/verify-windows-package.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "build": {
    "appId": "dev.linkmodel.desktop",
    "productName": "LinkModel",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "config/default.json",
      "assets/**/*",
      "!data/**",
      "!config/local.json"
    ],
    "nsis": {
      "include": "nsis/installer.nsh"
    },
    "extraResources": [
      {
        "from": "../shared",
        "to": "shared"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    }
  }
}
