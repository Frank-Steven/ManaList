<?xml version="1.0" encoding="utf-8"?>
<!-- 启动图标（2026-11-01 原生直显，Flutter 启动页已移除——
     启动画面完全由本文件 + @color/splash_bg 构成，引擎就绪后直接进入主界面）。

     版式：88dp（2026-11-01 用户：原 116dp 太大；
     1080px 屏 / 2.75 密度 ≈ 242px，屏宽 22.4%），水平垂直居中。
     位图放 drawable-nodpi（1024×1024 自带圆角与柔和阴影），
     由本层列表显式约束尺寸，避免密度换算误差。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="88dp"
        android:height="88dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/splash_icon"
            android:gravity="center" />
    </item>
</layer-list>
